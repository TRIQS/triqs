FROM ubuntu:26.04
ARG LLVM=21

# This platform does not regenerate Python bindings, but still installs clang /
# libclang / libomp / libzstd so that the shared Dockerfile.build clair install
# step succeeds (clair requires clang++-${LLVM}).
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
      clang-${LLVM} \
      cmake \
      g++ \
      gfortran \
      git \
      vim \
      lldb \
      hdf5-tools \
      libboost-dev \
      libclang-${LLVM}-dev \
      libomp-${LLVM}-dev \
      libzstd-dev \
      libfftw3-dev \
      libgfortran5 \
      libgmp-dev \
      libhdf5-dev \
      libopenblas-dev \
      libopenmpi-dev \
      openmpi-bin \
      openmpi-common \
      openmpi-doc \
      python3-dev \
      python3-mako \
      python3-matplotlib \
      python3-mpi4py \
      python3-numpy \
      python3-pip \
      python3-scipy

ENV PYTHON_VERSION=3.14 \
    CC=gcc CXX=g++
