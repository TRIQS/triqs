FROM ubuntu:24.04
ARG LLVM=19

# clang-${LLVM} is required to build clair (used for Python binding regeneration)
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
      clang-${LLVM} \
      cmake \
      g++ \
      gfortran \
      git \
      vim \
      lldb \
      hdf5-tools \
      libboost-dev \
      libclang-${LLVM}-dev \
      libomp-${LLVM}-dev \
      libzstd-dev \
      libfftw3-dev \
      libgfortran5 \
      libgmp-dev \
      libhdf5-dev \
      libopenblas-dev \
      libopenmpi-dev \
      openmpi-bin \
      openmpi-common \
      openmpi-doc \
      python3-dev \
      python3-mako \
      python3-matplotlib \
      python3-mpi4py \
      python3-numpy \
      python3-pip \
      python3-scipy

ENV PYTHON_VERSION=3.12 \
    CC=gcc CXX=g++
