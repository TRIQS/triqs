# Source this in your environment.

export TRIQS_ROOT=@CMAKE_INSTALL_PREFIX@

export PATH=@CMAKE_INSTALL_PREFIX@/bin:$PATH
# Some packages (e.g. pomerol2triqs, nrgljubljana_interface) install into lib/ rather than LIBDIR
export LD_LIBRARY_PATH=@CMAKE_INSTALL_PREFIX@/lib:@CMAKE_INSTALL_FULL_LIBDIR@:$LD_LIBRARY_PATH
export PYTHONPATH=@CMAKE_INSTALL_PREFIX@/@TRIQS_PYTHON_LIB_DEST_ROOT@:$PYTHONPATH
export CMAKE_PREFIX_PATH=@CMAKE_INSTALL_PREFIX@:$CMAKE_PREFIX_PATH
