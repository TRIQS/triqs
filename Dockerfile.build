# See packaging for various base options
FROM flatironinstitute/triqs:base
ARG APPNAME=triqs

ARG BUILDUID=983
RUN useradd -u $BUILDUID -m build

ENV SRC=/src \
    BUILD=/home/build \
    INSTALL=/usr/local \
    PYTHONPATH=/usr/local/lib/python$PYTHON_VERSION/site-packages \
    CMAKE_PREFIX_PATH=/usr/lib/cmake/$APPNAME \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

# Hacky patch for matplotlib sphinx bug (https://github.com/matplotlib/matplotlib/pull/12456?)
RUN ln -s /src /home/src

# Build and install clair so that clair-c2py is available for Python binding regeneration.
# Unset CPLUS_INCLUDE_PATH / CXXFLAGS for the whole block (not just the configure command)
# so that base-image settings (e.g. libc++ include path on ubuntu-intel) do not leak into
# the compile phase and mix libc++ headers with libstdc++ linkage.
RUN unset CPLUS_INCLUDE_PATH && unset CXXFLAGS && \
    git clone https://github.com/flatironinstitute/clair --branch unstable $SRC/clair && \
    mkdir $BUILD/clair && \
    CXX="clang++-${LLVM}" cmake -S $SRC/clair -B $BUILD/clair -DBuild_Tests=OFF -DCMAKE_INSTALL_PREFIX=$INSTALL && \
    cmake --build $BUILD/clair && \
    cmake --install $BUILD/clair

COPY --chown=build . $SRC/$APPNAME
WORKDIR $BUILD/$APPNAME
RUN chown build .
USER build
ARG BUILD_ID
ARG CMAKE_ARGS
ARG NCORES=4
RUN cmake $SRC/$APPNAME -DCMAKE_INSTALL_PREFIX=$INSTALL -DCLANG_OPT="$CXXFLAGS" $CMAKE_ARGS && make -j$NCORES || make -j1 VERBOSE=1
USER root
RUN make install
