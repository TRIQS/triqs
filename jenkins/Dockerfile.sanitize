FROM ubuntu:26.04
ENV LLVM=21

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
      clang-${LLVM} \
      cmake \
      g++ \
      gfortran \
      git \
      vim \
      lldb-${LLVM} \
      hdf5-tools \
      libboost-dev \
      libclang-${LLVM}-dev \
      libc++-${LLVM}-dev \
      libc++abi-${LLVM}-dev \
      libomp-${LLVM}-dev \
      libzstd-dev \
      libfftw3-dev \
      libgfortran5 \
      libgmp-dev \
      libhdf5-dev \
      libopenblas-dev \
      libopenmpi-dev \
      openmpi-bin \
      openmpi-common \
      openmpi-doc \
      python3-clang-${LLVM} \
      python3-dev \
      python3-mako \
      python3-matplotlib \
      python3-mpi4py \
      python3-numpy \
      python3-pip \
      python3-scipy

ENV PYTHON_VERSION=3.14 \
  CC=clang-${LLVM} CXX=clang++-${LLVM} CXXFLAGS="-stdlib=libc++" \
  ASAN_SYMBOLIZER_PATH=/usr/lib/llvm-${LLVM}/bin/llvm-symbolizer \
  ASAN_OPTIONS=symbolize=1:detect_leaks=0:alloc_dealloc_mismatch=0 \
  UBSAN_OPTIONS=symbolize=1:print_stacktrace=1:halt_on_error=1
# Open MPI 5+ routes through UCX by default, whose libucm malloc/mmap hooks
# collide with the LLVM sanitizer interceptors and SEGV inside MPI_Init. Route
# through the ob1 PML + shared-memory BTLs so libucm is never loaded. The mpi
# library sets the same flags via MPIEXEC_PREFLAGS, but that only reaches
# mpiexec-launched tests; setting them in the environment here also covers
# bare-python/mpi4py launches (e.g. singleton MPI_Init). See mpi/doc/sanitizers.md.
ENV OMPI_MCA_pml=ob1 \
  OMPI_MCA_btl=self,vader \
  OMPI_MCA_osc=^ucx
RUN update-alternatives --install /usr/bin/clang clang /usr/bin/clang-${LLVM} 60 --slave /usr/bin/clang++ clang++ /usr/bin/clang++-${LLVM} --slave /usr/bin/clang-cpp clang-cpp /usr/bin/clang-cpp-${LLVM}
